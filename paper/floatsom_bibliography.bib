@article{kratochvilGigaSOMjlHighperformanceClustering2020,
  title = {{{GigaSOM}}.Jl: {{High-performance}} Clustering and Visualization of Huge Cytometry Datasets},
  shorttitle = {{{GigaSOM}}.Jl},
  author = {Kratochv{\'i}l, Miroslav and Hunewald, Oliver and Heirendt, Laurent and Verissimo, Vasco and Vondr{\'a}{\v s}ek, Ji{\v r}{\'i} and Satagopam, Venkata P and Schneider, Reinhard and Trefois, Christophe and Ollert, Markus},
  year = 2020,
  month = nov,
  journal = {GigaScience},
  volume = {9},
  number = {11},
  pages = {giaa127},
  issn = {2047-217X},
  doi = {10.1093/gigascience/giaa127},
  urldate = {2026-04-09},
  abstract = {The amount of data generated in large clinical and phenotyping studies that use single-cell cytometry is constantly growing. Recent technological advances allow the easy generation of data with hundreds of millions of single-cell data points with \&gt;40 parameters, originating from thousands of individual samples. The analysis of that amount of high-dimensional data becomes demanding in both hardware and software of high-performance computational resources. Current software tools often do not scale to the datasets of such size; users are thus forced to downsample the data to bearable sizes, in turn losing accuracy and ability to detect many underlying complex phenomena.We present GigaSOM.jl, a fast and scalable implementation of clustering and dimensionality reduction for flow and mass cytometry data. The implementation of GigaSOM.jl in the high-level and high-performance programming language Julia makes it accessible to the scientific community and allows for efficient handling and processing of datasets with billions of data points using distributed computing infrastructures. We describe the design of GigaSOM.jl, measure its performance and horizontal scaling capability, and showcase the functionality on a large dataset from a recent study.GigaSOM.jl facilitates the use of commonly available high-performance computing resources to process the largest available datasets within minutes, while producing results of the same quality as the current state-of-art software. Measurements indicate that the performance scales to much larger datasets. The example use on the data from a massive mouse phenotyping effort confirms the applicability of GigaSOM.jl to huge-scale studies.},
  file = {C\:\\Users\\xuton\\Zotero\\storage\\HBHKDWZ6\\Kratochvíl et al. - 2020 - GigaSOM.jl High-performance clustering and visualization of huge cytometry datasets.pdf;C\:\\Users\\xuton\\Zotero\\storage\\WLDAQPDI\\giaa127.html}
}

