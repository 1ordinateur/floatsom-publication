  author = {Zhang, Haihan and Patrick, Matthew T. and Zhao, Jingyu and Zhai, Xintong and Liu, Jialin and Li, Zheng and Gu, Yiqian and Welch, Joshua and Zhou, Xiang and Modlin, Robert L. and Tsoi, Lam C. and Gudjonsson, Johann E.},
