@misc{lermiComparisonImagingbasedSinglecell2024,
  title = {Comparison of Imaging-Based Single-Cell Resolution Spatial Transcriptomics Profiling Platforms Using Formalin-Fixed, Paraffin-Embedded Tumor Samples},
  author = {Lermi, Nejla Ozirmak and Ayala, Max Molina and Hernandez, Sharia and Lu, Wei and Khan, Khaja and Serrano, Alejandra and Lubo, Idania and Hamana, Leticia and Tomczak, Katarzyna and Barnes, Sean and Dou, Jinzhuang and Liang, Qingnan and Team, R. T. I. and Raso, Maria Gabriela and Tang, Ximing and Jiang, Mei and {Sanchez-Espiridion}, Beatriz and Weissferdt, Annikka and Heymach, John and Zhang, Jianjun and Sepesi, Boris and Cascone, Tina and Tsao, Anne and Altan, Mehmet and Mehran, Reza and Gibbons, Don and Wistuba, Ignacio and Haymaker, Cara and Chen, Ken and Soto, Luisa M. Solis},
