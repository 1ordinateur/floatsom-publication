@article{changImagingMassCytometry2017,
  title = {Imaging {{Mass Cytometry}}},
  author = {Chang, Qing and Ornatsky, Olga I. and Siddiqui, Iram and Loboda, Alexander and Baranov, Vladimir I. and Hedley, David W.},
  year = 2017,
  journal = {Cytometry Part A},
  volume = {91},
  number = {2},
  pages = {160--169},
  issn = {1552-4930},
  doi = {10.1002/cyto.a.23053},
  urldate = {2025-12-03},
  abstract = {Imaging Mass Cytometry (IMC) is an expansion of mass cytometry, but rather than analyzing single cells in suspension, it uses laser ablation to generate plumes of particles that are carried to the mass cytometer by a stream of inert gas. Images reconstructed from tissue sections scanned by IMC have a resolution comparable to light microscopy, with the high content of mass cytometry enabled through the use of isotopically labeled probes and ICP-MS detection. Importantly, IMC can be performed on paraffin-embedded tissue sections, so can be applied to the retrospective analysis of patient cohorts whose outcome is known, and eventually to personalized medicine. Since the original description in 2014, IMC has evolved rapidly into a commercial instrument of unprecedented power for the analysis of histological sections. In this Review, we discuss the underlying principles of this new technology, and outline emerging applications of IMC in the analysis of normal and pathological tissues. \copyright{} 2017 International Society for Advancement of Cytometry},
  copyright = {\copyright{} 2017 International Society for Advancement of Cytometry},
  langid = {english},
  keywords = {cell signaling,hypoxia,image analysis,mass cytometry,systems biology},
